# LLM Configuration (OpenAI-compatible endpoint)
# LM Studio default: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=gemma-3-12b-it

# Server
HOST=0.0.0.0
PORT=8765

# TTS (Piper)
PIPER_MODEL=en_US-lessac-medium
PIPER_RATE=22050

# Avatar
VRM_MODEL_PATH=models/default.vrm

# Personality — "eve" (default), "spark" (energetic), "sage" (calm), "whisper" (shy)
PERSONALITY=eve

# Memory — max recent conversation turns to keep in full detail
MEMORY_MAX_RECENT_TURNS=30

# Telemetry — export session analytics on disconnect
TELEMETRY_ENABLED=true
# TELEMETRY_EXPORT_PATH=sessions/  # uncomment to save session JSON files
