# ============================================================
# Eve Avatar Engine — Configuration
# ============================================================
# Copy to .env and fill in your values.
# Velaris mode is enabled when VELARIS_URL is set.
# ============================================================

# --- Velaris Integration (primary mode) ---
# Set to enable Velaris mode — Eve becomes Velaris's body
# VELARIS_URL=http://100.72.225.119:8400
VELARIS_POLL_INTERVAL=3.0

# --- LLM Configuration (standalone mode only) ---
# Used when VELARIS_URL is not set
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=gemma-3-12b-it

# --- TTS: MiniMax Speech-02-HD (Velaris's voice) ---
# Set API key to enable MiniMax TTS
# MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_URL=https://api.minimaxi.chat
MINIMAX_VOICE=Wise_Woman

# --- TTS: Piper (local fallback) ---
PIPER_MODEL=en_US-lessac-medium
PIPER_RATE=22050
PIPER_ENABLED=true

# --- Server ---
HOST=0.0.0.0
PORT=8765

# --- Avatar ---
VRM_MODEL_PATH=models/default.vrm

# --- Tracking ---
# "webxr" (PSVR2/SteamVR), "webcam" (MediaPipe), "manual"
TRACKING_MODE=webxr

# --- Spatial ---
DEFAULT_DISTANCE=1.5
MIN_DISTANCE=0.5
MAX_DISTANCE=4.0

# --- Personality (standalone mode only) ---
# "eve" (default), "spark" (energetic), "sage" (calm), "whisper" (shy)
PERSONALITY=eve

# --- Memory (standalone mode only) ---
MEMORY_MAX_RECENT_TURNS=30

# --- Telemetry ---
TELEMETRY_ENABLED=true
# TELEMETRY_EXPORT_PATH=sessions/  # uncomment to save session JSON files
